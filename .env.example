# SecUR Environment Configuration
# Copy to .env and fill in values

# Model checkpoint path (mounted volume)
SECUR_CHECKPOINT=data/checkpoints/sec_ur_best.pt

# Qdrant vector store connection
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=sec_ur_docs

# JWT secret key (change in production!)
SECUR_SECRET_KEY=change-this-in-production

# NVD API key (optional, for data collection)
NVD_API_KEY=

# Embedding dimension (must match trained model)
SECUR_EMBEDDING_DIM=512
